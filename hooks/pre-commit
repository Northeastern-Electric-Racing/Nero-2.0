#!/bin/bash

# Find qmlformat dynamically
QMLFORMAT=$(find ~/Qt -name "qmlformat" -not -path "*.dSYM*" -not -path "*/Src/*" -not -path "*/tests/*" -not -path "*/manual/*" -not -path "*/DesignStudio/*" 2>/dev/null | head -1)

if [ -z "$QMLFORMAT" ]; then
    echo "Warning: qmlformat not found, skipping QML formatting"
fi

# Get all staged C++ files
CPP_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cpp|h)$')

# Get all staged QML files
QML_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.qml$')

# Run clang-format on C++ files
for FILE in $CPP_FILES; do
    clang-format -i "$FILE"
    git add "$FILE"
done

# Run qmlformat on QML files
if [ -n "$QMLFORMAT" ]; then
    for FILE in $QML_FILES; do
        $QMLFORMAT -i "$FILE"
        git add "$FILE"
    done
fi

exit 0
