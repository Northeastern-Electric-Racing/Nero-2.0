#!/bin/bash

# Detect OS and set qmlformat path (Qt 6.8.3)
if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" || "$OSTYPE" == "win32" ]]; then
    QMLFORMAT=~/Qt/6.8.3/mingw_64/bin/qmlformat.exe
else
    QMLFORMAT=~/Qt/6.8.3/macos/bin/qmlformat
fi

if [ ! -f "$QMLFORMAT" ]; then
    echo "Warning: qmlformat not found at $QMLFORMAT, skipping QML formatting"
fi

# Get all staged C++ files
CPP_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cpp|h)$')

# Get all staged QML files
QML_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.qml$')

# Run clang-format on C++ files
for FILE in $CPP_FILES; do
    clang-format -i "$FILE"
    git add "$FILE"
done

# Run qmlformat on QML files
if [ -f "$QMLFORMAT" ]; then
    for FILE in $QML_FILES; do
        $QMLFORMAT -i "$FILE"
        git add "$FILE"
    done
fi

exit 0
